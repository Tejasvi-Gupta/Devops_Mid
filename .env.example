# Local development placeholders. Copy to .env and replace every secret.
# Never commit .env. These values are not production credentials.

APP_ENV=development
APP_SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters
DATABASE_URL=postgresql+psycopg://epp:local-dev-only-change-me@localhost:5432/epp
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Leave blank until Google OAuth is configured. Google sign-in stays disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AGENT_PAIRING_CODE_TTL_SECONDS=300
LOG_LEVEL=INFO

# Used only by scripts/create_admin.py. Do not put a real password in this example.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Platform Admin

# Production only. Local Docker Compose does not read these.
AWS_REGION=us-east-1
CATALOG_PATH=
VITE_API_BASE_URL=
